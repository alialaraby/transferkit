{
  "name": "@transferkit/standards",
  "version": "0.1.0",
  "description": "Knowledge requirements and engineering handover standards for TransferKit",
  "license": "MIT",
  "author": "Ali Alaraby",
  "keywords": [
    "handover",
    "onboarding",
    "engineering",
    "documentation",
    "knowledge-transfer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alialaraby/transferkit.git",
    "directory": "packages/standards"
  },
  "bugs": "https://github.com/alialaraby/transferkit/issues",
  "homepage": "https://github.com/alialaraby/transferkit#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@transferkit/core": "0.1.0"
  }
}
