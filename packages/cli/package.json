{
  "name": "@transferkit/cli",
  "version": "0.1.0",
  "description": "Local-first CLI for structured software ownership transfer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alialaraby/transferkit.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/alialaraby/transferkit/issues",
  "homepage": "https://github.com/alialaraby/transferkit#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/bin.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "bin": {
    "tk": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@transferkit/core": "0.1.0",
    "@transferkit/renderers": "0.1.0",
    "@transferkit/scanners": "0.1.0",
    "@transferkit/standards": "0.1.0"
  }
}
